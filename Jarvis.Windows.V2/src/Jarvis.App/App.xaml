<Application
    x:Class="Jarvis.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="Canvas" Color="#080909" />
            <SolidColorBrush x:Key="Surface" Color="#101212" />
            <SolidColorBrush x:Key="SurfaceElevated" Color="#171A19" />
            <SolidColorBrush x:Key="Line" Color="#2A302D" />
            <SolidColorBrush x:Key="Ink" Color="#F4F1E9" />
            <SolidColorBrush x:Key="Muted" Color="#8F9690" />
            <SolidColorBrush x:Key="Signal" Color="#C9A45B" />
            <SolidColorBrush x:Key="SignalDim" Color="#67552F" />
            <SolidColorBrush x:Key="Alert" Color="#B9544D" />
            <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable Text" /><Setter Property="Foreground" Value="{StaticResource Ink}" /></Style>
            <Style x:Key="Label" TargetType="TextBlock"><Setter Property="FontFamily" Value="Cascadia Mono" /><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="CharacterSpacing" Value="110" /><Setter Property="Foreground" Value="{StaticResource Muted}" /></Style>
            <Style TargetType="Button"><Setter Property="Background" Value="#191D1B" /><Setter Property="Foreground" Value="{StaticResource Ink}" /><Setter Property="BorderBrush" Value="#3A423D" /><Setter Property="CornerRadius" Value="4" /><Setter Property="Padding" Value="14,8" /></Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
