<Window x:Class="Jarvis.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#01050A">
        <Grid.Resources>
            <LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#66101F32" Offset="0"/>
                <GradientStop Color="#33111A24" Offset="0.5"/>
                <GradientStop Color="#6613212D" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SkylineFill" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#161E2A35" Offset="0"/>
                <GradientStop Color="#03070B" Offset="1"/>
            </LinearGradientBrush>
            <SolidColorBrush x:Key="NeonBlue" Color="#45BCFF"/>
            <SolidColorBrush x:Key="SoftBlue" Color="#8CBFEA"/>
            <SolidColorBrush x:Key="DeepPanel" Color="#B006101B"/>
            <SolidColorBrush x:Key="PanelStroke" Color="#7744BFFF"/>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#020711" Offset="0"/>
                    <GradientStop Color="#020915" Offset="0.42"/>
                    <GradientStop Color="#000307" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <Ellipse Width="980" Height="260" Margin="-210,0,0,-250" HorizontalAlignment="Left" VerticalAlignment="Bottom" Stroke="#AA45BCFF" StrokeThickness="3" Fill="#070D1622"/>
            <Ellipse Width="900" Height="210" Margin="-180,0,0,-245" HorizontalAlignment="Left" VerticalAlignment="Bottom" Stroke="#2245BCFF" StrokeThickness="18"/>
            <Rectangle Width="6" HorizontalAlignment="Left" Margin="30,30,0,0" Fill="#2DBAFF" RadiusX="3" RadiusY="3" Height="96" VerticalAlignment="Top"/>
            <Rectangle Width="1" HorizontalAlignment="Right" Margin="0,0,16,0" Fill="#2445BCFF"/>
            <Grid HorizontalAlignment="Right" Width="520" Margin="0,90,0,0" Opacity="0.32">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Fill="{StaticResource SkylineFill}" Margin="12,140,20,0"/>
                <Rectangle Grid.Column="1" Fill="{StaticResource SkylineFill}" Margin="18,60,16,0"/>
                <Rectangle Grid.Column="2" Fill="{StaticResource SkylineFill}" Margin="18,100,16,0"/>
                <Rectangle Grid.Column="3" Fill="{StaticResource SkylineFill}" Margin="18,20,46,0"/>
            </Grid>

            <Grid Margin="80,48,80,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="10">
                    <TextBlock Text="J A R V I S" FontFamily="Segoe UI Variable Display" FontSize="38" FontWeight="SemiBold" Foreground="#F5FAFF" CharacterSpacing="420"/>
                    <TextBlock Text="UNIVERSAL OPERATING SURFACE" FontFamily="Cascadia Mono" FontSize="13" CharacterSpacing="420" Foreground="#49C6FF"/>
                </StackPanel>

                <Button Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="22,14" BorderBrush="#6645BCFF" BorderThickness="1" Background="#22071220" CornerRadius="10">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <TextBlock Text="☰" FontSize="22" Foreground="#49C6FF"/>
                        <TextBlock Text="MENU" FontFamily="Cascadia Mono" FontSize="15" CharacterSpacing="240" Foreground="#E8F7FF" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Home" Click="HomeNav_Click"/>
                            <MenuFlyoutItem Text="Computer" Click="ComputerNav_Click"/>
                            <MenuFlyoutItem Text="Developer" Click="DeveloperNav_Click"/>
                            <MenuFlyoutItem Text="Media" Click="MediaNav_Click"/>
                            <MenuFlyoutItem Text="Builder" Click="BuilderNav_Click"/>
                            <MenuFlyoutItem Text="Barehands" Click="BarehandsNav_Click"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="System / Diagnostics" Click="SystemNav_Click"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <StackPanel Grid.Row="1" Margin="0,120,0,0" Spacing="16" VerticalAlignment="Top">
                    <TextBlock Text="A MORE CAPABLE&#x0a;TOMORROW,&#x0a;TOGETHER." FontFamily="Cascadia Mono" FontSize="20" LineHeight="31" CharacterSpacing="320" Foreground="#8CBFEA"/>
                    <Rectangle Width="42" Height="1" Fill="#8CBFEA" HorizontalAlignment="Left"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,118,0,0" Spacing="12" VerticalAlignment="Top">
                    <TextBlock Text="LISTEN&#x0a;THINK&#x0a;CREATE&#x0a;EXECUTE" FontFamily="Cascadia Mono" FontSize="13" LineHeight="24" CharacterSpacing="360" Foreground="#9CD5FF"/>
                    <Rectangle Width="38" Height="1" Fill="#9CD5FF" HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,130" Spacing="12" VerticalAlignment="Bottom">
                    <TextBlock Text="BETTER&#x0a;TOOLS&#x0a;A BRIGHTER&#x0a;HUMANITY" FontFamily="Cascadia Mono" FontSize="13" LineHeight="24" CharacterSpacing="300" Foreground="#7FAAD1"/>
                    <Rectangle Width="38" Height="1" Fill="#7FAAD1" HorizontalAlignment="Left"/>
                </StackPanel>

                <Grid Grid.Row="1" Grid.Column="1">
                    <Grid x:Name="HomeView">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="360"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid HorizontalAlignment="Center" Width="660" Height="360">
                            <Ellipse Width="330" Height="330" Stroke="#2745BCFF" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse Width="270" Height="270" Stroke="#5545BCFF" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse Width="238" Height="238" Stroke="#DD37AFFF" StrokeThickness="5" Fill="#220C2B44" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse Width="198" Height="198" Stroke="#8845BCFF" StrokeThickness="2" Fill="#33102138" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse Width="96" Height="96" Stroke="#44CF3B46" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse Width="48" Height="48" Fill="#AAE2333D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse Width="18" Height="18" Fill="#FFFFF5F5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Rectangle Width="410" Height="2" Fill="#E0F13C48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="▁▂▃▄▅▆▇▆▅▄▃▂▁▂▃▅▇▆▅▄▃▂▁" FontFamily="Cascadia Mono" FontSize="22" Foreground="#F15A64" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel HorizontalAlignment="Right" Margin="0,145,70,0" Spacing="18">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <Ellipse x:Name="StatusDot" Width="11" Height="11" Fill="#F13C48" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CurrentStateText" Text="OFFLINE" FontFamily="Cascadia Mono" FontSize="18" CharacterSpacing="360" Foreground="#F5FAFF"/>
                            </StackPanel>
                            <TextBlock Text="▁▁▁▂▃▅▇▆▅▃▂▁▁▂▃▄▅▃▂▁" FontFamily="Cascadia Mono" FontSize="19" Foreground="#87D1FF"/>
                            <TextBlock x:Name="FaultStatusText" Text="Desktop shell ready. Voice is stopped." FontSize="20" Foreground="#8CBFEA"/>
                        </StackPanel>

                        <Border Grid.Row="1" Width="940" MaxHeight="285" HorizontalAlignment="Center" VerticalAlignment="Top" Background="{StaticResource GlassFill}" BorderBrush="{StaticResource PanelStroke}" BorderThickness="1" CornerRadius="20" Padding="24">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="46" Height="46" CornerRadius="23" BorderBrush="#55C7FF" BorderThickness="2" Background="#22163A55">
                                    <TextBlock Text="J" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" Foreground="#F5FAFF"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <TextBlock Text="JARVIS" FontFamily="Cascadia Mono" FontSize="16" CharacterSpacing="220" Foreground="#49C6FF"/>
                                        <TextBlock Text="Just now" FontSize="14" Foreground="#8AA4BF"/>
                                    </StackPanel>
                                    <TextBlock x:Name="HomeLatestJarvisText" Text="I'm listening.&#x0a;What would you like to work on today?" FontSize="25" LineHeight="34" Foreground="#F5FAFF" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="HomeLatestUserText" Text="You can ask for a build brief, a desktop operation, research, creative work, or anything else. I'm here to help." FontSize="18" LineHeight="27" Foreground="#94B8D8" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,10,0,0">
                                        <Button Content="Create a project plan" Click="BuilderNav_Click" Padding="22,9" Background="#22051424" BorderBrush="#5545BCFF" Foreground="#55C7FF" CornerRadius="18"/>
                                        <Button Content="Analyse this file" Click="DeveloperNav_Click" Padding="22,9" Background="#22051424" BorderBrush="#5545BCFF" Foreground="#55C7FF" CornerRadius="18"/>
                                        <Button Content="Open an app" Click="ComputerNav_Click" Padding="22,9" Background="#22051424" BorderBrush="#5545BCFF" Foreground="#55C7FF" CornerRadius="18"/>
                                        <Button Content="Research a topic" Click="SystemNav_Click" Padding="22,9" Background="#22051424" BorderBrush="#5545BCFF" Foreground="#55C7FF" CornerRadius="18"/>
                                    </StackPanel>
                                    <ListView x:Name="ConversationList" Visibility="Collapsed" Height="1"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid x:Name="ComputerView" Visibility="Collapsed">
                        <StackPanel Spacing="18" Margin="20">
                            <TextBlock Text="Computer" FontSize="34" FontWeight="SemiBold"/>
                            <TextBlock Text="Governed Windows operations resolve application, process, window, control, file, and document state separately." Foreground="{StaticResource Muted}" FontSize="16" TextWrapping="Wrap"/>
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Background="{StaticResource Surface}" Padding="18" CornerRadius="5"><StackPanel Spacing="8"><TextBlock Text="WINDOWS" Style="{StaticResource Label}" Foreground="{StaticResource Signal}"/><TextBlock Text="Discover / focus / state / graceful close"/></StackPanel></Border>
                                <Border Grid.Column="1" Background="{StaticResource Surface}" Padding="18" CornerRadius="5"><StackPanel Spacing="8"><TextBlock Text="FILES" Style="{StaticResource Label}" Foreground="{StaticResource Signal}"/><TextBlock Text="Folders / files / Explorer windows"/></StackPanel></Border>
                                <Border Grid.Column="2" Background="{StaticResource Surface}" Padding="18" CornerRadius="5"><StackPanel Spacing="8"><TextBlock Text="OFFICE" Style="{StaticResource Label}" Foreground="{StaticResource Signal}"/><TextBlock Text="Documents / workbooks / presentations"/></StackPanel></Border>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="DeveloperView" Visibility="Collapsed">
                        <Grid RowSpacing="16" Margin="20">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel Spacing="6"><TextBlock Text="Developer" FontSize="34" FontWeight="SemiBold"/><TextBlock Text="Bounded source inspection, edits, tests, and builds remain behind Developer governance." Foreground="{StaticResource Muted}" FontSize="16"/></StackPanel>
                            <Border Grid.Row="1" Background="{StaticResource Surface}" Padding="18" CornerRadius="5">
                                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="DeveloperWorkspaceTextBox" PlaceholderText="Approved workspace"/><TextBox Grid.Column="1" x:Name="DeveloperObjectiveTextBox" PlaceholderText="Bounded development objective"/><Button Grid.Column="2" x:Name="RunDeveloperTaskButton" Content="Run Dev Task" Click="RunDeveloperTaskButton_Click"/></Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="MediaView" Visibility="Collapsed">
                        <StackPanel Spacing="16" Margin="20">
                            <TextBlock Text="Media" FontSize="34" FontWeight="SemiBold"/>
                            <TextBlock Text="ALEXIS promo media remains governed and evidence-backed." Foreground="{StaticResource Muted}" FontSize="16"/>
                            <Border Background="{StaticResource Surface}" Padding="20" CornerRadius="5">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="ALEXIS PROMO MEDIA" Style="{StaticResource Label}" Foreground="{StaticResource Signal}"/>
                                    <TextBox x:Name="MediaSceneTextBox" Text="1" PlaceholderText="Scene"/>
                                    <TextBox x:Name="MediaCandidateTextBox" PlaceholderText="Candidate path or candidate ID"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="GenerateMediaButton" Content="Generate" Click="GenerateMediaButton_Click"/><Button x:Name="RegisterMediaButton" Content="Register" Click="RegisterMediaButton_Click"/><Button x:Name="ApproveMediaButton" Content="Approve" Click="ApproveMediaButton_Click"/><Button x:Name="RejectMediaButton" Content="Reject" Click="RejectMediaButton_Click"/></StackPanel>
                                    <TextBlock x:Name="MediaStatusText" Text="ALEXIS_PROMO_001 ready." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="BuilderView" Visibility="Collapsed" Margin="0,10,0,0">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Background="#99070707" BorderBrush="#8A6A2A" BorderThickness="1" Padding="12" CornerRadius="8">
                                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="BUILDER" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="BuilderModeText" Text="DESIGN" Style="{StaticResource Label}" Foreground="{StaticResource Signal}" VerticalAlignment="Bottom"/></StackPanel><TextBlock Grid.Column="1" x:Name="BuilderProjectText" Text="No App Builder project loaded." TextWrapping="Wrap" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7"><Button x:Name="CreateBuilderProjectButton" Content="Load" Click="CreateBuilderProjectButton_Click"/><Button x:Name="GenerateBuilderMockButton" Content="Render" Click="GenerateBuilderMockButton_Click"/><Button x:Name="ReviseBuilderMockButton" Content="Revise" Click="ReviseBuilderMockButton_Click"/><Button x:Name="AcceptBuilderMockButton" Content="Accept" Click="AcceptBuilderMockButton_Click"/><Button x:Name="RejectBuilderMockButton" Content="Reject" Click="RejectBuilderMockButton_Click"/></StackPanel></Grid>
                            </Border>
                            <Grid Grid.Row="1" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition x:Name="BuilderLeftColumn" Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="BuilderRightColumn" Width="300"/></Grid.ColumnDefinitions>
                                <Border x:Name="BuilderLeftPanel" Background="#BB060B10" BorderBrush="#2A5C8A" BorderThickness="1" Padding="12" CornerRadius="8"><StackPanel Spacing="10"><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="-" Click="CollapseBuilderLeft_Click"/><TextBlock Text="NAVIGATOR" Style="{StaticResource Label}" Foreground="{StaticResource Signal}" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="BuilderSummaryText" Text="Load the project to recover durable Builder context." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><TextBlock Text="CAPABILITY TRUTH" Style="{StaticResource Label}"/><TextBlock x:Name="BuilderCapabilityText" Text="Inventory not loaded." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Border>
                                <Grid Grid.Column="1" RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Spacing="6"><Button Content="DESIGN" Click="BuilderDesignMode_Click"/><Button Content="PREVIEW" Click="BuilderPreviewMode_Click"/><Button Content="INSPECT" Click="BuilderInspectMode_Click"/></StackPanel><Border Grid.Row="1" Background="#030303" BorderBrush="#45BCFF" BorderThickness="1" Padding="8" CornerRadius="8"><Viewbox Stretch="Uniform"><Grid Width="1280" Height="720" Background="#050505"><WebView2 x:Name="BuilderPreviewWebView" Width="1280" Height="720"/></Grid></Viewbox></Border></Grid>
                                <Border x:Name="BuilderRightPanel" Grid.Column="2" Background="#BB060B10" BorderBrush="#2A5C8A" BorderThickness="1" Padding="12" CornerRadius="8"><StackPanel Spacing="10"><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="-" Click="CollapseBuilderRight_Click"/><TextBlock Text="INSPECTOR" Style="{StaticResource Label}" Foreground="{StaticResource Signal}" VerticalAlignment="Center"/></StackPanel><TextBlock Text="CURRENT SCREEN / REVISION" Style="{StaticResource Label}"/><TextBlock x:Name="BuilderRevisionText" Text="No candidate yet." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><TextBlock Text="SELECTION" Style="{StaticResource Label}"/><TextBlock x:Name="BuilderSelectionText" Text="None." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><TextBlock Text="VISUAL EVALUATION" Style="{StaticResource Label}"/><TextBlock x:Name="BuilderEvaluationText" Text="No rendered evidence yet." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Border>
                            </Grid>
                        </Grid>
                    </Grid>

                    <Grid x:Name="SystemView" Visibility="Collapsed" Margin="20">
                        <Grid RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Spacing="6"><TextBlock Text="System / Diagnostics" FontSize="34" FontWeight="SemiBold"/><TextBlock Text="Detailed lifecycle, Realtime, capability, and tool evidence remains available without dominating the operating surface." Foreground="{StaticResource Muted}" FontSize="16" TextWrapping="Wrap"/></StackPanel><Grid Grid.Row="1" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="{StaticResource Surface}" Padding="14" CornerRadius="5"><StackPanel Spacing="8"><TextBlock Text="LATEST TRANSCRIPT" Style="{StaticResource Label}"/><TextBlock x:Name="LatestTranscriptText" Text="No transcript yet." TextWrapping="Wrap"/></StackPanel></Border><Border Grid.Column="1" Background="{StaticResource Surface}" Padding="14" CornerRadius="5"><StackPanel Spacing="8"><TextBlock Text="JARVIS RESPONSE" Style="{StaticResource Label}"/><TextBlock x:Name="LatestResponseText" Text="Ready." TextWrapping="Wrap"/></StackPanel></Border><Border Grid.Column="2" Background="{StaticResource Surface}" Padding="14" CornerRadius="5"><StackPanel Spacing="8"><TextBlock Text="RUNTIME CONTROLS" Style="{StaticResource Label}" Foreground="{StaticResource Signal}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="StartVoiceButton" Content="Start Voice" Click="StartVoiceButton_Click"/><Button x:Name="StopVoiceButton" Content="Stop Voice" Click="StopVoiceButton_Click" IsEnabled="False"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="StartRealtimeButton" Content="Start Realtime" Click="StartRealtimeButton_Click"/><Button x:Name="StopRealtimeButton" Content="Stop Realtime" Click="StopRealtimeButton_Click" IsEnabled="False"/></StackPanel></StackPanel></Border></Grid><Border Grid.Row="2" Background="{StaticResource Surface}" Padding="18" CornerRadius="5"><StackPanel Spacing="10"><TextBlock Text="CAPABILITY ACTIVITY" Style="{StaticResource Label}" Foreground="{StaticResource Signal}"/><ListView x:Name="ActivityLogList" Background="Transparent" BorderThickness="0" SelectionMode="None"/></StackPanel></Border></Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="1" Width="1320" MinHeight="108" Margin="0,0,0,38" HorizontalAlignment="Center" Background="#B005111E" BorderBrush="#AA55C7FF" BorderThickness="1.5" CornerRadius="24" Padding="22">
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Content="+" Width="58" Height="58" FontSize="30" Background="#33142638" BorderBrush="#4455C7FF" Foreground="#BFEAFF" CornerRadius="29"/>
                <TextBox Grid.Column="1" x:Name="CommandTextBox" PlaceholderText="Talk to Jarvis or type a command..." AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58" MaxHeight="148" KeyDown="CommandTextBox_KeyDown" TextChanged="CommandTextBox_TextChanged" FontSize="22" Background="#99101D2B" BorderBrush="#2245BCFF" Foreground="#F5FAFF" PlaceholderForeground="#788DA7" Padding="22,14"/>
                <Button Grid.Column="2" Content="⌨" Width="58" Height="58" FontSize="24" Background="#22142638" BorderBrush="#3345BCFF" Foreground="#BFEAFF" CornerRadius="29"/>
                <Button Grid.Column="3" x:Name="ComposerMicButton" Content="🎙" Click="ComposerMicButton_Click" Width="78" Height="78" FontSize="34" Background="#3345BCFF" BorderBrush="#FF55C7FF" BorderThickness="2" Foreground="#FFFFFF" CornerRadius="39"/>
                <Button Grid.Column="4" x:Name="SendCommandButton" Content="➤" Click="SendCommandButton_Click" IsEnabled="False" Width="58" Height="58" FontSize="24" Background="#22142638" BorderBrush="#3345BCFF" Foreground="#BFEAFF" CornerRadius="29"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" Orientation="Horizontal" Spacing="24">
            <Rectangle Width="42" Height="1" Fill="#638CBFEA" VerticalAlignment="Center"/>
            <TextBlock Text="INTELLIGENCE  FOR  A  BRIGHTER  TOMORROW" FontFamily="Cascadia Mono" FontSize="12" CharacterSpacing="360" Foreground="#8CBFEA"/>
            <Rectangle Width="42" Height="1" Fill="#638CBFEA" VerticalAlignment="Center"/>
        </StackPanel>

        <WebView2 x:Name="RealtimeTransportWebView" Grid.RowSpan="2" Width="1" Height="1" Opacity="0.01" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" />
    </Grid>
</Window>
